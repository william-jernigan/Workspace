{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Sensitive"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "System": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      {
        "Name": "WithSensitiveDataMasking",
        "Args": {
          "options": {
            "Operators": [
              "Serilog.Enrichers.Sensitive.CreditCardMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.EmailAddressMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.IbanMaskingOperator, Serilog.Enrichers.Sensitive",
              "Enterprise.Utilities.Serilog.Enrichers.Sensitive.SSNMaskingOperator, Enterprise.Utilities.Serilog.Enrichers.Sensitive"
            ]
          }
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ],
    "Properties": {
      "ApplicationName": "APITransformationsFunction"
    }
  },
  "CatalogService": {
    "BaseUrl": "https://api.dev.onegrandvacation.com/one-exch-catalog-svc-service/1/",
    "SubscriptionKey": "9c5f9b1cd4534d7f87680e74c7dc58dc",
    "Version": 1
  },
  "MemberService": {
    "BaseUrl": "https://api.dev.onegrandvacation.com/one-exch-member-svc-service/1/",
    "SubscriptionKey": "9c5f9b1cd4534d7f87680e74c7dc58dc",
    "Version": 1
  },
  "InventoryService": {
    "BaseUrl": "https://api.dev.onegrandvacation.com/one-exch-inv-svc-service/api/",
    "SubscriptionKey": "9c5f9b1cd4534d7f87680e74c7dc58dc",
    "Version": 1
  },
  "OrderServiceDev": {
    "BaseUrl": "https://api.dev.onegrandvacation.com/one-exch-order-svc-service/api/",
    "SubscriptionKey": "9c5f9b1cd4534d7f87680e74c7dc58dc",
    "Version": 2
  },
  "OrderService": {
    "BaseUrl": "https://api.qat.onegrandvacation.com/one-exch-order-svc-service/api/",
    "SubscriptionKey": "4d804e5e9a7f4a12a06386c21c17bbbe",
    "Version": 2
  }
}
