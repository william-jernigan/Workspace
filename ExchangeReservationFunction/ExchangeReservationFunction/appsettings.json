{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Sensitive"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "System": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      {
        "Name": "WithSensitiveDataMasking",
        "Args": {
          "options": {
            "Operators": [
              "Serilog.Enrichers.Sensitive.CreditCardMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.EmailAddressMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.IbanMaskingOperator, Serilog.Enrichers.Sensitive",
              "Enterprise.Utilities.Serilog.Enrichers.Sensitive.SSNMaskingOperator, Enterprise.Utilities.Serilog.Enrichers.Sensitive"
            ]
          }
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ],
    "Properties": {
      "ApplicationName": "ExchangeReservationFunction"
    }
  },
  "OrderService": {
    "BaseUrl": "https://api.qat.onegrandvacation.com/one-exch-order-svc-service/api/",
    "SubscriptionKey": "XXXXX",
    "Version": 2
  }
}
