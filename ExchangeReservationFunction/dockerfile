# Build Stage
FROM acrusw3shdnonprodv2.azurecr.io/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy csproj and restore as distinct layers for caching
COPY ./*.sln ./nuget.config ./Directory.Packages.props  ./
COPY ./*/*.csproj ./
RUN for file in $(ls *.csproj); do mkdir -p ${file%.*}/ && mv $file ${file%.*}/; done
ARG FEED_ACCESSTOKEN
ENV VSS_NUGET_EXTERNAL_FEED_ENDPOINTS="{\"endpointCredentials\": [{\"endpoint\":\"https://hiltongrandvacations.pkgs.visualstudio.com/_packaging/OneVision/nuget/v3/index.json\", \"username\":\"docker\", \"password\":\"${FEED_ACCESSTOKEN}\"}, {\"endpoint\":\"https://hiltongrandvacations.pkgs.visualstudio.com/_packaging/HGVC/nuget/v3/index.json\", \"username\":\"docker\", \"password\":\"${FEED_ACCESSTOKEN}\"}]}"
RUN dotnet restore

# Copy and publish app and libraries
COPY . .
RUN dotnet publish -c Release -o out --no-restore --p:SkipGenOpenAPI=true ./ExchangeReservationFunction/ExchangeReservationFunction.csproj
# Serve Stage
FROM acrusw3shdnonprodv2.azurecr.io/dotnet/azure-function:8.0
ENV AzureWebJobsScriptRoot=/home/site/wwwroot
WORKDIR /home/site/wwwroot
COPY --from=build /src/out .

CMD [ "/azure-functions-host/Microsoft.Azure.WebJobs.Script.WebHost" ]
