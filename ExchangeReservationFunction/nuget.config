<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="HGVC" value="https://hiltongrandvacations.pkgs.visualstudio.com/_packaging/HGVC/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="OneVision" value="https://hiltongrandvacations.pkgs.visualstudio.com/_packaging/OneVision/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="swashbuckle.aspnetcore.cli" />
      <package pattern="nbgv" />
      <package pattern="Apim.DevOps.Toolkit" />
    </packageSource>
    <packageSource key="HGVC">
