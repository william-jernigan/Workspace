{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Sensitive"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "System": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      {
        "Name": "WithSensitiveDataMasking",
        "Args": {
          "options": {
            "Operators": [
              "Serilog.Enrichers.Sensitive.CreditCardMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.EmailAddressMaskingOperator, Serilog.Enrichers.Sensitive",
              "Serilog.Enrichers.Sensitive.IbanMaskingOperator, Serilog.Enrichers.Sensitive",
              "Enterprise.Utilities.Serilog.Enrichers.Sensitive.SSNMaskingOperator, Enterprise.Utilities.Serilog.Enrichers.Sensitive"
            ]
          }
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Enterprise.Utilities.Serilog.EcsTextFormatter.OneSystemEcsTextFormatter, Enterprise.Utilities.Serilog.EcsTextFormatter"
        }
      }
    ],
    "Properties": {
      "ApplicationName": "OneExchangeOrderService"
    }
  },

  "ConnectionStrings": {
    "OneExchangeConnectionString": "Server=sql-usw3-dev-ont.database.windows.net;Database=sqldb-usw3-dev-exchange;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=\"Active Directory Managed Identity\";"
  },
  "OrderReservationEventHub": {
    "EventHubNamespace": "ehn-usw3-dev-exchange.servicebus.windows.net",
    "ReservationRequestEventhubName": "evh-usw3-dev-exchange-order-requested",
    "CancellationRequestEventhubName": "evh-usw3-dev-exchange-order-cancellation-requested"
  },
  "ContentfulSettings": {
    "ManagementToken": "",
    "DeliveryToken": "",
    "SpaceId": "4e7n5dlolv8t",
    "EnvironmentId": "dev"
  },
  "InRules": {
    "InRuleBaseUrl": "https://api.qat.onegrandvacation.com/rules-service/v1/Rules/OneExchangeV1/decision/",
    "SubscriptionKey": ""
  },
  "InventoryService": {
    "BaseUrl": "https://api.dev.onegrandvacation.com/one-exch-inv-svc-service/api/",
    "SubscriptionKey": "",
    "Version": "1"
  },
  "EventHubs": {
    "Notifications": {
      "Namespace": "ehn-usw3-dev-notifications.servicebus.windows.net",
      "EventName": "evh-usw3-dev-notifications-notification"
    }
  },
  "BoomiConnectorApi": {
    "BaseUrl": "http://hap-shd-npd.hgvapi.com:8077/ws/rest/",
    "ApiKeys": {
      "Reservation": ""
    },
    "Authorization": ""
  },
   "DeploymentEnvironment": "DEV"

}






